   1          #include <reg52.h>
   2          
   3          /* Pinouts:
   4             PIR  -> P1.0
   5             RELAY-> P1.1 (active HIGH)
   6             LCD  -> P2 (4-bit)
   7               RS P2.0
   8               RW P2.1
   9               EN P2.2
  10               D4 P2.4
  11               D5 P2.5
  12               D6 P2.6
  13               D7 P2.7
  14          */
  15          
  16          sbit PIR    = P1^0;
  17          sbit RELAY  = P1^1;
  18          
  19          sbit LCD_RS = P2^0;
  20          sbit LCD_RW = P2^1;
  21          sbit LCD_EN = P2^2;
  22          #define LCD_DATA_PORT P2
  23          
  24          void delay_ms(unsigned int ms) {
  25   1          unsigned int i, j;
  26   1          for(i = 0; i < ms; i++)
  27   1              for(j = 0; j < 120; j++); // ~1ms at 11.0592MHz (tweak if needed)
  28   1      }
  29          
  30          /* small pulse */
  31          void lcd_enable_pulse(void) {
  32   1          LCD_EN = 1;
  33   1          { volatile unsigned char x = 0; x++; } // tiny
  34   1          LCD_EN = 0;
  35   1      }
  36          
  37          /* write 4-bit nibble to P2.4-P2.7 */
  38          void lcd_write_nibble(unsigned char nib) {
  39   1          LCD_DATA_PORT &= 0x0F;                // clear P2.4-P2.7
  40   1          LCD_DATA_PORT |= ( (nib & 0x0F) << 4 );
  41   1          lcd_enable_pulse();
  42   1      }
  43          
  44          void lcd_cmd(unsigned char cmd) {
  45   1          LCD_RS = 0;
  46   1          LCD_RW = 0;
  47   1          lcd_write_nibble(cmd >> 4);
  48   1          lcd_write_nibble(cmd & 0x0F);
  49   1          delay_ms(2);
  50   1      }
  51          
  52          void lcd_data(unsigned char dat) {
  53   1          LCD_RS = 1;
  54   1          LCD_RW = 0;
C51 COMPILER V9.60.7.0   MAIN                                                              12/10/2025 20:08:22 PAGE 2   

  55   1          lcd_write_nibble(dat >> 4);
  56   1          lcd_write_nibble(dat & 0x0F);
  57   1          delay_ms(1);
  58   1      }
  59          
  60          /* convenience print function to match your lcd_print usage */
  61          void lcd_print(char *s) {
  62   1          while(*s) lcd_data(*s++);
  63   1      }
  64          
  65          void lcd_init(void) {
  66   1          LCD_RS = 0;
  67   1          LCD_RW = 0;
  68   1          LCD_EN = 0;
  69   1          delay_ms(20);
  70   1      
  71   1          /* Init sequence (4-bit) */
  72   1          LCD_DATA_PORT &= 0x0F;
  73   1          LCD_DATA_PORT |= (0x03 << 4); lcd_enable_pulse(); delay_ms(5);
  74   1          LCD_DATA_PORT &= 0x0F;
  75   1          LCD_DATA_PORT |= (0x03 << 4); lcd_enable_pulse(); delay_ms(1);
  76   1          LCD_DATA_PORT &= 0x0F;
  77   1          LCD_DATA_PORT |= (0x03 << 4); lcd_enable_pulse(); delay_ms(1);
  78   1      
  79   1          LCD_DATA_PORT &= 0x0F;
  80   1          LCD_DATA_PORT |= (0x02 << 4); lcd_enable_pulse(); delay_ms(1);
  81   1      
  82   1          lcd_cmd(0x28); // function set: 4-bit, 2 line, 5x8
  83   1          lcd_cmd(0x06); // entry mode
  84   1          lcd_cmd(0x0C); // display ON, cursor OFF
  85   1          lcd_cmd(0x01); // clear
  86   1          delay_ms(2);
  87   1      }
  88          
  89          void lcd_goto(unsigned char row, unsigned char col) {
  90   1          unsigned char addr;
  91   1          if(row == 1) addr = 0x00 + (col - 1);
  92   1          else addr = 0x40 + (col - 1);
  93   1          lcd_cmd(0x80 | addr);
  94   1      }
  95          
  96          /* small helper: print and pad with spaces to clear old text */
  97          void lcd_print_pad(char *s, unsigned char pad) {
  98   1          while(*s) lcd_data(*s++);
  99   1          while(pad--) lcd_data(' ');
 100   1      }
 101          
 102          /* a long busy-wait used to mimic your for(j=0;j<30000;j++) delays in splash */
 103          void long_busy(unsigned int loops) {
 104   1          volatile unsigned int j;
 105   1          for(j = 0; j < loops; j++); // loops ~ delay; tweak loops if needed
 106   1      }
