   1          #include <reg51.h>
   2          
   3          // Define motor control port
   4          #define STEPPER P1  // Stepper motor connected to Port 1
   5          
   6          // Define switch pin
   7          sbit switch_pin = P2^7;  // Switch connected to P2.7
   8          
   9          // Delay function to control motor speed
  10          void delay(unsigned int time) {
  11   1          unsigned int i, j;
  12   1          for(i = 0; i < time; i++)
  13   1              for(j = 0; j < 1275; j++);  // Approx 1ms delay
  14   1      }
  15          
  16          // Function to rotate motor clockwise using 03H, 06H, 09H, 0CH sequence
  17          void stepper_clockwise(void) {
  18   1          STEPPER = 0x03;  // Step 1 (03H)
  19   1          delay(1);
  20   1          STEPPER = 0x06;  // Step 2 (06H)
  21   1          delay(1);
  22   1          STEPPER = 0x0C;  // Step 3 (0CH)
  23   1          delay(1);
  24   1          STEPPER = 0x09;  // Step 4 (09H)
  25   1          delay(1);
  26   1      }
  27          
  28          // Function to rotate motor counterclockwise using reverse 0CH, 09H, 06H, 03H sequence
  29          void stepper_counterclockwise(void) {
  30   1          STEPPER = 0x09;  // Step 1 (09H)
  31   1          delay(1);
  32   1          STEPPER = 0x0C;  // Step 2 (0CH)
  33   1          delay(1);
  34   1          STEPPER = 0x06;  // Step 3 (06H)
  35   1          delay(1);
  36   1          STEPPER = 0x03;  // Step 4 (03H)
  37   1          delay(1);
  38   1      }
  39          
  40          void main(void) {
  41   1          while(1) {
  42   2              if (switch_pin == 1) {
  43   3                  // Switch is pressed, rotate stepper motor clockwise
  44   3                  stepper_clockwise();
  45   3              } else {
  46   3                  // Switch is not pressed, rotate stepper motor counterclockwise
  47   3                  stepper_counterclockwise();
  48   3              }
  49   2          }
  50   1      }


